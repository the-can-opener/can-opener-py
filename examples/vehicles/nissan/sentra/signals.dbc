VAL_ 1549 LOW_BEAMS 0 "off" 1 "on";
VAL_ 1549 HIGH_BEAMS 0 "off" 1 "on";
VAL_ 1549 LEFT_SIGNAL 0 "off" 1 "on";
VAL_ 1549 RIGHT_SIGNAL 0 "off" 1 "on";
VAL_ 1549 FRONT_LEFT_DOOR_OPEN 0 "closed" 1 "open";
VAL_ 1549 FRONT_RIGHT_DOOR_OPEN 0 "closed" 1 "open";
VAL_ 1549 REAR_LEFT_DOOR_OPEN 0 "closed" 1 "open";
VAL_ 1549 REAR_RIGHT_DOOR_OPEN 0 "closed" 1 "open";
VAL_ 852 BRAKE_LIGHTS 0 "off" 1 "on";
VAL_ 852 TCS_OFF 0 "off" 1 "on";
VAL_ 505 AC_REQ 0 "off" 1 "on";

CM_ BO_ 1549 "CAN ID 0x60D from Nissan Sentra 2010 notes. Light-related signals plus door ajar bits included because they share the same frame.";
CM_ SG_ 1549 LOW_BEAMS "From nissan.md: A.2-A.3 => low beams are on when the high bit is set; this treats both 0b10 low beams and 0b11 fog lights as LOW_BEAMS=1.";
CM_ SG_ 1549 HIGH_BEAMS "From nissan.md: B.4 => 0 high beams off, 1 high beams on.";
CM_ SG_ 1549 LEFT_SIGNAL "From nissan.md: B.6 => 0 left signal off, 1 left signal on.";
CM_ SG_ 1549 RIGHT_SIGNAL "From nissan.md: B.7 => 0 right signal off, 1 right signal on.";
CM_ SG_ 1549 FRONT_LEFT_DOOR_OPEN "From nissan.md: A.4 => 0 closed, 1 open.";
CM_ SG_ 1549 FRONT_RIGHT_DOOR_OPEN "From nissan.md: A.5 => 0 closed, 1 open.";
CM_ SG_ 1549 REAR_LEFT_DOOR_OPEN "From nissan.md: A.6 => 0 closed, 1 open.";
CM_ SG_ 1549 REAR_RIGHT_DOOR_OPEN "From nissan.md: A.7 => 0 closed, 1 open.";
CM_ BO_ 1893 "CAN ID 0x765 positive responses to body-control requests sent on 0x745.";
